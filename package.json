{
  "name": "coffeewater",
  "version": "0.1.0",
  "private": true,
  "description": "Find bottled-water blends for coffee from what's on supermarket shelves in your country.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "validate": "tsx scripts/validate-data.ts",
    "recommend": "tsx scripts/recommend.ts",
    "check": "npm run typecheck && npm run validate && npm test"
  },
  "dependencies": {
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.18.12",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
